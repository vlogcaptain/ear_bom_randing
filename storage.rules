rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // 1. 전문가(관리자) 확인 함수: Firestore admins 컬렉션 참조
    function isExpert() {
      return request.auth != null && 
             firestore.exists(/databases/(default)/documents/admins/$(request.auth.token.email));
    }

    // 2. 앱(1.0.2 & 1.0.3) 사진 경로: ear_images/{userId}/{filename}
    match /ear_images/{userId}/{allPaths=**} {
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read: if (request.auth != null && request.auth.uid == userId) || isExpert();
      allow delete: if isExpert();
      allow update: if false;
    }

    // 3. 닷컴 웹 사진 경로: ear_photos/{userId}/{filename}
    match /ear_photos/{userId}/{allPaths=**} {
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read: if (request.auth != null && request.auth.uid == userId) || isExpert();
      allow delete: if isExpert();
      allow update: if false;
    }

    // 4. 레거시 단일 파일 호환 경로: ear_photos/{photoId}
    match /ear_photos/{photoId} {
      allow read: if isExpert() || (request.auth != null && photoId.split('_')[0] == request.auth.uid);
      allow delete: if isExpert();
      allow write: if false;
    }

    // 5. 기본 차단 정책 (Deny by default)
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
